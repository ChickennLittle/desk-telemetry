import serial
import matplotlib.pyplot as plt
from collections import deque

# cambia COM se serve
SERIAL_PORT = "COM3"
BAUDRATE = 115200

ser = serial.Serial(SERIAL_PORT, BAUDRATE)

max_points = 100
temp_data = deque(maxlen=max_points)
vib_data = deque(maxlen=max_points)
load_data = deque(maxlen=max_points)

plt.ion()
fig, ax = plt.subplots()

while True:
    line = ser.readline().decode().strip()

    try:
        temp, vib, load = map(float, line.split(","))

        temp_data.append(temp)
        vib_data.append(vib)
        load_data.append(load)

        ax.clear()
        ax.plot(temp_data, label="Temp")
        ax.plot(vib_data, label="Vib")
        ax.plot(load_data, label="Load")

        ax.legend()
        ax.set_ylim(0, 100)
        plt.pause(0.05)

    except:
        continue